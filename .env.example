# Chave da Anthropic (obrigatória):
ANTHROPIC_API_KEY=sk-ant-...

# Opcionais
# EMPORIO_MODEL=claude-haiku-5-5
# "hoje" do agente (os CSVs são um retrato congelado de março/2026)
# EMPORIO_HOJE=2026-03-23

# Alternativa: qualquer API compatível com OpenAI (o modelo precisa suportar function calling).
# Comente a linha da Anthropic e use:
# EMPORIO_PROVEDOR=openai
# EMPORIO_API_KEY=...
# EMPORIO_BASE_URL=https://...     (vazio = api.openai.com)
# EMPORIO_MODEL=...
