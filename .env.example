# Fill in ONE provider key.
# DeepSeek (default):
DEEPSEEK_API_KEY=sk-...
# or Anthropic (comment the line above and use this one):
# ANTHROPIC_API_KEY=sk-ant-...

# Optional
# EMPORIO_PROVEDOR=deepseek          # or anthropic (otherwise picked from the keys present)
# EMPORIO_MODEL=deepseek-flash       # default: deepseek-flash / claude-haiku-5-5
# EMPORIO_BASE_URL=https://api.deepseek.com   # any OpenAI-compatible API (then use EMPORIO_API_KEY)
# "today" for the agent (the CSVs are a frozen snapshot from March 2026)
# EMPORIO_HOJE=2026-03-23
